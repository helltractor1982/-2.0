/* pages/home/home.wxss */

/* 英雄区 */
.hero-section {
  margin: 0 30rpx 20rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #5BA0E9 40%, #7EC8F0 100%);
  border-radius: 32rpx;
  overflow: hidden;
  position: relative;
}

.hero-bg {
  position: absolute;
  top: -40rpx;
  right: -30rpx;
  opacity: 0.15;
}

.hero-icon {
  font-size: 240rpx;
}

.hero-content {
  padding: 50rpx 40rpx 30rpx;
  position: relative;
  z-index: 1;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 8rpx;
}

.hero-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 搜索入口 */
.search-entry {
  margin: 0 40rpx 30rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

.search-entry-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}

.search-entry-text {
  font-size: 28rpx;
  color: #999999;
  flex: 1;
}

/* 功能入口网格 */
.feature-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 30rpx 20rpx;
  gap: 20rpx;
}

.feature-item {
  width: calc(50% - 10rpx);
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.feature-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.feature-icon {
  font-size: 48rpx;
}

.feature-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.feature-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

/* 统计条 */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 0 30rpx 20rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A90D9;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #999999;
}

.stats-divider {
  width: 2rpx;
  height: 50rpx;
  background: #E8E8E8;
}

/* Section 通用 */
.section {
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.section-more {
  font-size: 26rpx;
  color: #4A90D9;
}

/* 推荐滑动卡片 */
.recommend-scroll {
  white-space: nowrap;
  padding: 0 30rpx;
}

.recommend-card {
  display: inline-block;
  width: 220rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx 24rpx;
  margin-right: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.recommend-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.recommend-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 6rpx;
  white-space: normal;
}

.recommend-en {
  font-size: 20rpx;
  color: #999999;
  margin-bottom: 10rpx;
  white-space: normal;
}

.recommend-size {
  display: inline-block;
  font-size: 20rpx;
  color: #4A90D9;
  background: #E8F0FE;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

/* 体型标签 */
.size-tags {
  display: flex;
  flex-wrap: wrap;
  padding: 0 30rpx;
  gap: 16rpx;
}

.size-tag {
  background: #F0F2F5;
  color: #666666;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  transition: all 0.2s;
}

.size-tag:active {
  background: #E8F0FE;
  color: #4A90D9;
}
