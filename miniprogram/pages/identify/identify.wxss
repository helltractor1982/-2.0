/* pages/identify/identify.wxss */

/* 上传区 */
.upload-area {
  text-align: center;
  padding: 80rpx 40rpx;
  margin-top: 40rpx;
}

.upload-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #E8F0FE, #F0F5FF);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 30rpx;
}

.upload-icon {
  font-size: 80rpx;
}

.upload-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}

.upload-desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 40rpx;
}

.upload-btns {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.upload-btn {
  width: 480rpx;
}

.upload-tips {
  display: flex;
  align-items: flex-start;
  background: #FFF9F0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  text-align: left;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #B8860B;
  line-height: 1.6;
}

/* 预览区 */
.preview-area {
  padding: 30rpx;
}

.preview-image-wrap {
  background: #F0F2F5;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 600rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.preview-actions {
  display: flex;
  gap: 24rpx;
}

.preview-actions .btn-outline,
.preview-actions .btn-primary {
  flex: 1;
}

/* 识别中动画 */
.identifying-area {
  padding: 60rpx 40rpx;
  margin-top: 40rpx;
}

.identify-animation {
  position: relative;
  width: 400rpx;
  height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #F0F2F5;
}

.identifying-image {
  width: 100%;
  height: 100%;
  opacity: 0.5;
}

.scan-line {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #4A90D9, transparent);
  animation: scan 2s ease-in-out infinite;
  z-index: 2;
}

@keyframes scan {
  0%, 100% { top: 0; }
  50% { top: 100%; }
}

.identify-tips {
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #999999;
  text-align: center;
}

/* ====== 识别结果 ====== */

/* 最佳匹配 */
.top-result {
  margin-top: 30rpx;
  position: relative;
  padding-top: 50rpx;
}

.result-badge {
  position: absolute;
  top: -24rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #FF7B54, #FF9A6C);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 36rpx;
  border-radius: 28rpx;
  white-space: nowrap;
}

.top-result-content {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.result-emoji {
  font-size: 100rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.result-info {
  flex: 1;
}

.result-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 6rpx;
}

.result-en {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.result-confidence {
  margin-bottom: 16rpx;
}

.confidence-bar {
  width: 100%;
  height: 12rpx;
  background: #F0F2F5;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.confidence-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90D9, #6BA8E5);
  border-radius: 6rpx;
  transition: width 1s ease;
}

.confidence-text {
  font-size: 22rpx;
  color: #666666;
}

.result-tags {
  display: flex;
  flex-wrap: wrap;
}

.btn-detail {
  width: 100%;
}

/* 其他可能匹配 */
.other-results {
  padding: 20rpx 0;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.match-count {
  font-size: 24rpx;
  font-weight: 400;
  color: #999999;
}

.other-result-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
}

.other-rank {
  font-size: 22rpx;
  color: #4A90D9;
  font-weight: 700;
  margin-right: 20rpx;
  min-width: 50rpx;
}

.other-emoji {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.other-info {
  flex: 1;
  min-width: 0;
}

.other-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
}

.other-en {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 10rpx;
}

.other-confidence-bar {
  width: 200rpx;
  height: 8rpx;
  background: #F0F2F5;
  border-radius: 4rpx;
  overflow: hidden;
}

.confidence-fill-sm {
  height: 100%;
  background: #4A90D9;
  border-radius: 4rpx;
}

.other-percent {
  font-size: 24rpx;
  color: #4A90D9;
  font-weight: 600;
  margin-left: 16rpx;
}

/* 底部操作 */
.result-actions {
  display: flex;
  gap: 24rpx;
  padding: 30rpx;
}

.result-actions .btn-primary,
.result-actions .btn-outline {
  flex: 1;
}
